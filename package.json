{
  "name": "orbit-desktop",
  "productName": "Orbit",
  "version": "0.1.7",
  "private": true,
  "description": "Orbit — a mouse-first radial launcher for Windows",
  "main": "src/main.cjs",
  "author": "Orbit",
  "license": "UNLICENSED",
  "scripts": {
    "icons": "node scripts/build-icons.cjs",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start": "npm run native && electron .",
    "setup": "install-electron && npm run native",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/check-ui.cjs",
    "test:search": "node scripts/check-app-search.cjs",
    "smoke": "npm run native && electron . --smoke-test",
    "package": "npm run icons && npm run native && electron-packager . Orbit --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/orbit.ico --asar.unpackDir=native --ignore=\"(^/release|^/\\.git($|/)|^/\\.github($|/)|^/tests|^/test-results|^/output|^/docs|^/dist|playwright.config|package-lock)\"",
    "release:archive": "node scripts/create-release.cjs",
    "release": "npm run package && npm run release:archive",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "test:updates": "node scripts/check-updates.cjs",
    "test:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-updater.ps1",
    "test:drag": "node scripts/check-drag.cjs",
    "test:icons": "node scripts/check-icons.cjs",
    "test:wheel-drag": "node scripts/check-wheel-drag.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.2.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Validolio11/Orbit.git"
  },
  "homepage": "https://github.com/Validolio11/Orbit#readme",
  "bugs": {
    "url": "https://github.com/Validolio11/Orbit/issues"
  }
}
